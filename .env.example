# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# Gemini image generation (server-side only; never use a VITE_ prefix)
GEMINI_API_KEY=

# Stripe Checkout (server-side only; never use a VITE_ prefix)
STRIPE_SECRET_KEY=


# Transactional email (server-side only)
RESEND_API_KEY=
RESEND_FROM=              # Verified sender, e.g. hello@kiwikoru3d.com
RESEND_TO=kiwikoru3d@gmail.com

# Stripe webhook (server-side only)
STRIPE_WEBHOOK_SECRET=    # whsec_… from Stripe endpoint configuration
